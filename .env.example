# Copy to .env.local and fill in. Never commit real values.

# Public site URL, used for canonical links and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Caelinex Business OS API address.
CAELINEX_API_URL=http://localhost:3002

# Caelinex Storefront API key (Settings -> Storefront -> Storefront API keys). Server only: never prefix with NEXT_PUBLIC_.
CAELINEX_STOREFRONT_KEY=csk_your_key_here
